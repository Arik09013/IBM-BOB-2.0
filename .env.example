# =============================================================================
# TestPilot AI — Environment Variable Template
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider: "openai" | "ollama" | "stub"
# Default: ollama (free, local — no API key required)
# Use "stub" for offline unit tests and CI pipelines.
# -----------------------------------------------------------------------------
TESTPILOT_LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Model name (used by the selected provider)
# OpenAI examples:  gpt-4o   gpt-4o-mini   gpt-3.5-turbo
# Ollama examples:  codellama   mistral   llama3   deepseek-coder
# -----------------------------------------------------------------------------
TESTPILOT_LLM_MODEL=codellama

# -----------------------------------------------------------------------------
# OpenAI (only required when TESTPILOT_LLM_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
# NEVER commit a real key — use this file as a template only.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Ollama (only required when TESTPILOT_LLM_PROVIDER=ollama)
# Default base URL assumes Ollama running locally on port 11434.
# Start Ollama with: ollama serve
# Pull a model with: ollama pull codellama
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# -----------------------------------------------------------------------------
# LLM tuning parameters
# -----------------------------------------------------------------------------
TESTPILOT_LLM_TEMPERATURE=0.2
TESTPILOT_LLM_MAX_TOKENS=4096
TESTPILOT_LLM_REQUEST_TIMEOUT=120.0

# -----------------------------------------------------------------------------
# Runtime settings
# -----------------------------------------------------------------------------
TESTPILOT_LOG_LEVEL=INFO
TESTPILOT_OUTPUT_DIR=./output
TESTPILOT_MAX_REPAIR_ITERATIONS=2
TESTPILOT_TEST_EXECUTION_TIMEOUT=60.0
